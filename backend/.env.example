# ============================================
# Polymarket AI Trading Platform - Environment
# ============================================

# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://polymarket:polymarket@localhost:5432/polymarket
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Polymarket
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CHAIN_ID=137

# Wallet (for execution)
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=

# AI - Anthropic (primary)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=3.0
AI_CACHE_TTL_SECONDS=300
AI_ENABLED=true

# AI - OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Trading Config
PAPER_TRADING_MODE=true
MAX_POSITION_SIZE_USDC=100.0
MAX_TOTAL_EXPOSURE_USDC=1000.0
MAX_POSITIONS=10
DEFAULT_SLIPPAGE_PCT=0.02
RISK_ENGINE_ENABLED=true

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# CORS (for web frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
